#!/bin/bash
# chomper — setup, auth, then runs the Compose stack.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
export SCRIPT_DIR
ENV_FILE="$SCRIPT_DIR/.env"

# Read a single KEY=value from .env (empty if absent).
_env_get() { grep "^$1=" "$ENV_FILE" 2>/dev/null | cut -d= -f2-; }

# ── First-run setup ───────────────────────────────────────────────────────
if ! grep -q "^OPENPROJECT_URL=" "$ENV_FILE" 2>/dev/null; then
  mkdir -p "$SCRIPT_DIR/.chomper"
  echo ""
  echo "=== First run — quick setup ==="
  echo ""
  printf "  OpenProject URL [https://community.openproject.org]: "
  read -r OPENPROJECT_URL; OPENPROJECT_URL="${OPENPROJECT_URL:-https://community.openproject.org}"
  OPENPROJECT_TOKEN=""
  while [ -z "$OPENPROJECT_TOKEN" ]; do
    printf "  API token (read-only, View work packages only): "
    read -rs OPENPROJECT_TOKEN; echo ""
    [ -z "$OPENPROJECT_TOKEN" ] && echo "  Token is required — please enter a value."
  done
  {
    printf 'OPENPROJECT_URL=%s\n' "$OPENPROJECT_URL"
    printf 'OPENPROJECT_TOKEN=%s\n' "$OPENPROJECT_TOKEN"
  } > "$ENV_FILE"
  chmod 600 "$ENV_FILE"
  echo ""
  echo "  ✓ Saved to .env (gitignored, chmod 600)"
  echo ""
fi

if ! grep -q "^OP_REPO_PATH=" "$ENV_FILE" 2>/dev/null; then
  printf "  Do you have a local OpenProject repo to reuse? [Y/n]: "
  read -r HAS_REPO
  if [[ "${HAS_REPO:-Y}" =~ ^[Nn] ]]; then
    OP_REPO_PATH_ENTRY="false"
    echo "  Will clone opf/openproject when first needed (no auth required)."
  else
    printf "  Path to your product repo [../openproject]: "
    read -r OP_REPO_PATH_INPUT; OP_REPO_PATH_INPUT="${OP_REPO_PATH_INPUT:-../openproject}"
    OP_REPO_PATH_ENTRY="$OP_REPO_PATH_INPUT"
  fi
  printf 'OP_REPO_PATH=%s\n' "$OP_REPO_PATH_ENTRY" >> "$ENV_FILE"
  echo ""
fi

if ! grep -q "^CHOMPER_ALLOWED_EMAILS=" "$ENV_FILE" 2>/dev/null; then
  _OP_URL="$(_env_get OPENPROJECT_URL)"
  echo "  Without an allowlist, ANY OpenProject user can trigger @chomper."
  while :; do
    printf "  Emails allowed to trigger @chomper (comma-separated): "
    read -r CHOMPER_ALLOWED_EMAILS
    [ -n "$CHOMPER_ALLOWED_EMAILS" ] && break
    # On the public community instance an open trigger means anyone on the
    # internet can spend your tokens — refuse to proceed without a list.
    if [[ "$_OP_URL" != *community.openproject.org* ]]; then
      printf "  Leave empty to allow ALL users — are you sure? [y/N]: "
      read -r _CONFIRM_OPEN
      [[ "${_CONFIRM_OPEN:-N}" =~ ^[Yy] ]] && break
    else
      echo "  An allowlist is required when targeting the public community instance."
    fi
  done
  printf 'CHOMPER_ALLOWED_EMAILS=%s\n' "$CHOMPER_ALLOWED_EMAILS" >> "$ENV_FILE"
  echo ""
fi

if ! grep -q "^ANTHROPIC_API_KEY=" "$ENV_FILE" 2>/dev/null; then
  # With a key, it's held only by the authgw gateway — never passed to the claude
  # container. Left blank, chomper falls back to interactive `claude auth login`
  # (OAuth creds live in the claude container, so that path is less isolated).
  echo "  Anthropic API key — recommended; kept out of the claude container."
  echo "  Leave blank to log in interactively instead (OAuth)."
  printf "  Anthropic API key (sk-ant-…), or blank: "
  read -rs ANTHROPIC_API_KEY_ENTRY; echo ""
  printf 'ANTHROPIC_API_KEY=%s\n' "$ANTHROPIC_API_KEY_ENTRY" >> "$ENV_FILE"
  echo ""
fi

# ── Load config ───────────────────────────────────────────────────────────
_OP_REPO_PATH_RAW="$(_env_get OP_REPO_PATH)"
if [[ "$_OP_REPO_PATH_RAW" == "false" ]]; then
  OP_REPO_PATH="$SCRIPT_DIR/.chomper/openproject"
  _CLONE_REPO=true
else
  OP_REPO_PATH="$(cd "$SCRIPT_DIR" && cd "$_OP_REPO_PATH_RAW" && pwd)"
  _CLONE_REPO=false
fi
export OP_REPO_PATH
# Mount path for compose (kept distinct from OP_REPO_PATH, whose .env value may
# be relative or "false"); see the volumes comment in compose.yml.
export OP_REPO="$OP_REPO_PATH"
mkdir -p "$SCRIPT_DIR/.chomper/claude-auth"

# ── Git identity — passed into the runner container so commits are authored
#    by the host user rather than the container's default identity.
GIT_AUTHOR_NAME="$(git config user.name 2>/dev/null || true)"
GIT_AUTHOR_EMAIL="$(git config user.email 2>/dev/null || true)"
export GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL
export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME" GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"

# ── Run ───────────────────────────────────────────────────────────────────
# `backlog show` and `backlog skip` work from local caches — no worktree,
# claude, or proxy needed. Unknown subcommands are passed through to Ruby.
CMD="${1:-}"
SUBCMD="${2:-}"
_needs_claude=false
case "$CMD" in
  agent|fix|plan) _needs_claude=true ;;
  backlog)   [[ -z "$SUBCMD" || "$SUBCMD" == "triage" || "$SUBCMD" == "process" || "$SUBCMD" == "plan" ]] && _needs_claude=true ;;
esac
if [[ "$_needs_claude" == "true" ]]; then
  # Auth: an API key (preferred) is held only by the authgw gateway and never
  # reaches the claude container. With no key, fall back to interactive
  # `claude auth login` — its OAuth creds live in the claude container's config
  # dir (.chomper/claude-auth), so that path is less isolated than the gateway.
  if [[ -z "${ANTHROPIC_API_KEY:-}" ]]; then
    ANTHROPIC_API_KEY="$(_env_get ANTHROPIC_API_KEY)"
  fi
  _USE_GATEWAY=false
  if [[ -n "$ANTHROPIC_API_KEY" ]]; then
    export ANTHROPIC_API_KEY
    export CHOMPER_GW_TOKEN="chomper-internal-gateway"
    export CHOMPER_CLAUDE_BASE_URL="http://authgw:47292"
    _USE_GATEWAY=true
    echo "[ Claude auth: API key via authgw gateway ]"
  else
    echo "[ Claude auth: no API key set — using LESS SECURE interactive login (OAuth) ]"
  fi

  WORKTREE="$SCRIPT_DIR/.chomper/openproject"
  # Git-level backstop (defense in depth on top of Clients::GitHub.protected_branch?):
  # point this throwaway checkout at chomper's pre-push hook so no push from it can
  # ever reach dev/release*, keyed on the destination ref. $SCRIPT_DIR resolves
  # identically inside the runner container (same mount invariant as the worktree).
  HOOKS_DIR="$SCRIPT_DIR/githooks"
  if [[ "$_CLONE_REPO" == "true" ]]; then
    if [ ! -d "$WORKTREE/.git" ]; then
      echo "[ Cloning opf/openproject — this may take a few minutes ]"
      git clone https://github.com/opf/openproject.git "$WORKTREE"
      echo "  ✓ Cloned to $WORKTREE"
      echo ""
    else
      git -C "$WORKTREE" fetch --quiet origin dev
    fi
    # Standalone clone — its config is chomper-owned, so a plain local setting is isolated.
    git -C "$WORKTREE" config core.hooksPath "$HOOKS_DIR"
  else
    git -C "$OP_REPO_PATH" fetch --quiet origin dev
    if ! git -C "$WORKTREE" rev-parse --git-dir &>/dev/null; then
      echo "[ Creating isolated worktree (your repo checkout is untouched) ]"
      git -C "$OP_REPO_PATH" worktree add --detach "$WORKTREE" origin/dev
      echo "  ✓ Worktree at $WORKTREE"
      echo ""
    fi
    # Linked worktree — scope hooksPath to this worktree (config.worktree) so the
    # user's own repo and its hooks stay untouched.
    git -C "$WORKTREE" config extensions.worktreeConfig true
    git -C "$WORKTREE" config --worktree core.hooksPath "$HOOKS_DIR"
  fi
  if [[ "$_USE_GATEWAY" == "true" ]]; then
    # proxy starts as claude's dependency; authgw is named explicitly so it only
    # runs in API-key mode (it requires the real key and would exit otherwise).
    docker compose -f "$SCRIPT_DIR/compose.yml" up -d --wait --remove-orphans authgw claude
  else
    # OAuth: ensure the CLI is logged in (creds persist in .chomper/claude-auth).
    if ! docker compose -f "$SCRIPT_DIR/compose.yml" run --rm \
        claude claude auth status &>/dev/null; then
      echo "[ Claude auth required — follow the prompts below ]"
      docker compose -f "$SCRIPT_DIR/compose.yml" run --rm --remove-orphans \
        claude claude auth login
      echo ""
    fi
    docker compose -f "$SCRIPT_DIR/compose.yml" up -d --wait --remove-orphans claude
  fi
  trap 'docker compose -f "$SCRIPT_DIR/compose.yml" stop claude proxy authgw 2>/dev/null || true' EXIT INT TERM
fi
docker compose --progress quiet -f "$SCRIPT_DIR/compose.yml" run --no-deps --rm --remove-orphans runner ruby "$SCRIPT_DIR/bin/chomper" "$@"
