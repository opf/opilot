#!/bin/bash
# chomper — setup, auth, then runs the Compose stack.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
export SCRIPT_DIR
ENV_FILE="$SCRIPT_DIR/.env"
CMD="${1:-}"; SUBCMD="${2:-}"

# Read / append a single KEY=value in .env. A missing key yields empty (not a
# failure), so a bare `VAR="$(_env_get KEY)"` is safe under `set -euo pipefail`.
_env_get() { grep "^$1=" "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true; }
_save()    { printf '%s=%s\n' "$1" "$2" >> "$ENV_FILE"; }
# docker compose bound to chomper's compose file.
dc() { docker compose -f "$SCRIPT_DIR/compose.yml" "$@"; }

# Teardown commands like `reset` must never run the first-run wizard — it would
# prompt for config (and tokens) it's about to discard.
case "$CMD" in reset) _WIZARD=false ;; *) _WIZARD=true ;; esac
# True when the wizard should prompt for KEY (enabled and not yet in .env).
_need() { [[ "$_WIZARD" == true ]] && ! grep -q "^$1=" "$ENV_FILE" 2>/dev/null; }

# ── First-run setup ───────────────────────────────────────────────────────
if _need OPENPROJECT_URL; then
  mkdir -p "$SCRIPT_DIR/.chomper"
  echo ""; echo "=== First run — quick setup ==="; echo ""
  printf "  OpenProject URL [https://community.openproject.org]: "
  read -r OPENPROJECT_URL; OPENPROJECT_URL="${OPENPROJECT_URL:-https://community.openproject.org}"
  OPENPROJECT_TOKEN=""
  while [ -z "$OPENPROJECT_TOKEN" ]; do
    printf "  API token (view work packages + comment on them): "
    read -rs OPENPROJECT_TOKEN; echo ""
    [ -z "$OPENPROJECT_TOKEN" ] && echo "  Token is required — please enter a value."
  done
  _save OPENPROJECT_URL "$OPENPROJECT_URL"
  _save OPENPROJECT_TOKEN "$OPENPROJECT_TOKEN"
  chmod 600 "$ENV_FILE"
  echo ""
fi


if _need CHOMPER_ALLOWED_OP_USER_IDS; then
  echo "  Without an allowlist, ANY OpenProject user can trigger @chomper."
  echo "  Use OpenProject user ids (the number in a profile URL, /users/<id>) —"
  echo "  a non-admin API token can't read other users' emails."
  while :; do
    printf "  User ids allowed to trigger @chomper (comma-separated): "
    read -r CHOMPER_ALLOWED_OP_USER_IDS
    [ -n "$CHOMPER_ALLOWED_OP_USER_IDS" ] && break
    # On the public community instance an open trigger lets anyone on the
    # internet spend your tokens — refuse to proceed without a list.
    if [[ "$(_env_get OPENPROJECT_URL)" == *community.openproject.org* ]]; then
      echo "  An allowlist is required when targeting the public community instance."
    else
      printf "  Leave empty to allow ALL users — are you sure? [y/N]: "
      read -r _CONFIRM; [[ "${_CONFIRM:-N}" =~ ^[Yy] ]] && break
    fi
  done
  _save CHOMPER_ALLOWED_OP_USER_IDS "$CHOMPER_ALLOWED_OP_USER_IDS"
  echo ""
fi

if _need ANTHROPIC_API_KEY; then
  # With a key, it's held only by the authgw gateway — never passed to the claude
  # container. Left blank, chomper falls back to interactive `claude auth login`
  # (OAuth creds live in the claude container, so that path is less isolated).
  echo "  Anthropic API key — recommended; kept out of the claude container."
  echo "  Leave blank to log in interactively instead (OAuth)."
  printf "  Anthropic API key (sk-ant-…), or blank: "
  read -rs ANTHROPIC_API_KEY_ENTRY; echo ""
  _save ANTHROPIC_API_KEY "$ANTHROPIC_API_KEY_ENTRY"
  echo ""
fi

if _need CHOMPER_PR_MODE; then
  # How chomper delivers PRs decides what kind of GitHub token it needs, so ask
  # this before the token. Fork mode (default) is the isolated path; direct mode
  # trades that isolation for a token with push access to the canonical repo.
  echo "  How should chomper deliver PRs?"
  echo "    [f]ork   (default) — runs as a dedicated BOT account with NO access to the"
  echo "                         canonical repo; forks it, pushes to the fork, opens a"
  echo "                         cross-repo draft PR. Most isolated."
  echo "    [d]irect           — pushes the fix branch straight to the canonical repo and"
  echo "                         opens a same-repo draft PR. Needs a token with push"
  echo "                         access; the protected-branch guard is the only backstop."
  printf "  Mode [F/d]: "
  read -r _MODE
  if [[ "${_MODE:-f}" =~ ^[Dd] ]]; then CHOMPER_PR_MODE=direct; else CHOMPER_PR_MODE=fork; fi
  _save CHOMPER_PR_MODE "$CHOMPER_PR_MODE"
  echo ""
fi

if _need GITHUB_TOKEN; then
  if [[ "${CHOMPER_PR_MODE:-$(_env_get CHOMPER_PR_MODE)}" == "direct" ]]; then
    # Direct mode: the token pushes branches to the canonical repo and opens
    # same-repo PRs, so it MUST have push access there. No fork, no isolation —
    # the protected-branch guard + draft-PR-with-human-merge are the only safety.
    echo "  GitHub token — DIRECT mode: chomper pushes branches to the canonical repo."
    echo "  Use a token for an account WITH push access to the product repo, with the"
    echo "  classic 'repo' scope ('public_repo' is enough for a public repo), plus 'gist'"
    echo "  (so chomper can attach each plan as a gist linked from the PR):"
    echo "    https://github.com/settings/tokens (classic → repo + gist)"
    echo "  chomper still opens DRAFT PRs; merging stays gated on a maintainer."
    echo "  Leave blank to skip (planning/chat work; publishing PRs won't)."
    printf "  GitHub token (ghp_…), or blank: "
  else
    # Fork mode: chomper acts as a dedicated GitHub BOT account — it forks the
    # product repo, pushes fix branches to that fork, and opens draft PRs against
    # upstream. The isolation comes from the bot account having NO access to the
    # canonical repo — so even a classic 'public_repo' token can't write there.
    # Classic public_repo is required (fine-grained tokens can't open fork→upstream PRs).
    # 'workflow' scope is also required: the bot's fork lags upstream, so a fix
    # branch based on the current base re-introduces upstream's .github/workflows/*
    # files relative to the stale fork, and GitHub rejects a classic PAT that
    # creates/updates any workflow file without it. 'gist' lets chomper attach
    # each WP's full plan as a secret gist linked from the PR (skipped if absent).
    echo "  GitHub token — chomper runs as a dedicated BOT account, not you."
    echo "  Create a SEPARATE GitHub account that is NOT a collaborator on the product"
    echo "  repo (a personal/user account — org accounts can't grant maintainer edits),"
    echo "  then make a classic token for IT with the 'public_repo', 'workflow' and 'gist' scopes:"
    echo "    https://github.com/settings/tokens (classic → public_repo + workflow + gist)"
    echo "  chomper auto-creates the bot's fork on first publish. Because the bot has no"
    echo "  access to the canonical repo, it physically cannot push there."
    echo "  Leave blank to skip (planning/chat work; publishing PRs won't)."
    printf "  Bot GitHub token (ghp_…), or blank: "
  fi
  read -rs GITHUB_TOKEN_ENTRY; echo ""
  _save GITHUB_TOKEN "$GITHUB_TOKEN_ENTRY"
  echo ""
fi

# Only meaningful once a token is set (gh-agent needs it); skip otherwise.
if _need CHOMPER_ALLOWED_GH_USERS && [ -n "$(_env_get GITHUB_TOKEN)" ]; then
  # gh-agent lets the listed GitHub users push code to chomper's PR branches, so
  # an empty list (any user can trigger on a public PR) needs explicit confirmation.
  echo "  GitHub logins allowed to trigger @chomper on a PR (gh-agent), comma-separated."
  while :; do
    printf "  Allowed GitHub users: "
    read -r CHOMPER_ALLOWED_GH_USERS
    [ -n "$CHOMPER_ALLOWED_GH_USERS" ] && break
    printf "  Empty = ANY GitHub user can push code to your PR branch — sure? [y/N]: "
    read -r _CONFIRM; [[ "${_CONFIRM:-N}" =~ ^[Yy] ]] && break
  done
  _save CHOMPER_ALLOWED_GH_USERS "$CHOMPER_ALLOWED_GH_USERS"
  echo ""
fi

# ── Load config ───────────────────────────────────────────────────────────
# repos.json is the single source of truth for the set of repos; each is a
# standalone clone provisioned below from `bin/repos list`. OP_REPO_PATH is an
# optional override that seeds the openproject clone from a local checkout (a
# faster clone) — exported so `bin/repos` sees it inside the runner container.
OP_REPO_PATH="$(_env_get OP_REPO_PATH)"
export OP_REPO_PATH
mkdir -p "$SCRIPT_DIR/.chomper/claude-auth"

# Run the containers as the host user so everything they write into the bind-mounted
# .chomper/ (runner: logs + item state; claude: its auth creds) is owned by you, not
# root/node. On macOS Docker Desktop remaps ownership to the host user regardless;
# on Linux the container uid is used verbatim, so without this the runner (root)
# leaves root-owned files and the claude container (node, uid 1000) can't write its
# auth into a host-owned dir — breaking auth persistence.
CHOMPER_UID="$(id -u)"; CHOMPER_GID="$(id -g)"
export CHOMPER_UID CHOMPER_GID

# Git identity — passed into the runner container so commits are authored by the
# host user rather than the container's default identity.
GIT_AUTHOR_NAME="$(git config user.name 2>/dev/null || true)"
GIT_AUTHOR_EMAIL="$(git config user.email 2>/dev/null || true)"
export GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL
export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME" GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"

# ── Run ───────────────────────────────────────────────────────────────────
# `backlog show`/`skip` work from local caches — no worktree, claude, or proxy
# needed. Unknown subcommands are passed through to Ruby.
_needs_claude=false
case "$CMD" in
  agent|op-agent|gh-agent|fix|plan|chat) _needs_claude=true ;;
  backlog) [[ -z "$SUBCMD" || "$SUBCMD" =~ ^(triage|process|plan)$ ]] && _needs_claude=true ;;
esac
if [[ "$_needs_claude" == true ]]; then
  # Auth: an API key (preferred) is held only by the authgw gateway and never
  # reaches the claude container. With no key, fall back to interactive
  # `claude auth login` — its OAuth creds live in the claude container's config
  # dir (.chomper/claude-auth), so that path is less isolated than the gateway.
  : "${ANTHROPIC_API_KEY:=$(_env_get ANTHROPIC_API_KEY)}"
  _USE_GATEWAY=false
  if [[ -n "$ANTHROPIC_API_KEY" ]]; then
    export ANTHROPIC_API_KEY
    export CHOMPER_GW_TOKEN="chomper-internal-gateway"
    export CHOMPER_CLAUDE_BASE_URL="http://authgw:47292"
    _USE_GATEWAY=true
  fi

  # Git-level backstop (defense in depth on top of Clients::GitHub.protected_branch?):
  # point each throwaway clone at chomper's pre-push hook so no push from it can
  # ever reach a base/release branch, keyed on the destination ref.
  HOOKS_DIR="$SCRIPT_DIR/githooks"
  mkdir -p "$SCRIPT_DIR/.chomper/repos"

  # Clone each repo into .chomper/repos/<name>. `bin/repos list` emits a real host
  # path for repos that have a local checkout to seed from; --reference-if-able
  # makes that clone fast, and --dissociate keeps it fully standalone afterwards
  # (no runtime dependency on the local checkout, no special mounts).
  while IFS='|' read -r _name _upstream _base _shared; do
    [ -z "$_name" ] && continue
    WT="$SCRIPT_DIR/.chomper/repos/$_name"
    if [ ! -d "$WT/.git" ]; then
      _url="https://github.com/$_upstream.git"
      echo "[ Cloning $_upstream ($_base)${_shared:+ — seeding from $_shared} ]"
      # Seed from the local checkout when given (--reference-if-able), then
      # --dissociate so the clone keeps no runtime dependency on it. A failed
      # clone (e.g. a wrong base branch) warns and is skipped rather than
      # aborting the whole launch — fix repos.json and re-run to pick it up.
      if [ -n "$_shared" ]; then
        git clone --reference-if-able "$_shared" --dissociate --branch "$_base" "$_url" "$WT"
      else
        git clone --branch "$_base" "$_url" "$WT"
      fi || { echo "  ⚠ Could not clone $_upstream ($_base) — skipping. Check its \"base\" in repos.json."; rm -rf "$WT"; continue; }
    else
      git -C "$WT" fetch --quiet origin "$_base" || true
    fi
    git -C "$WT" config core.hooksPath "$HOOKS_DIR"
  done < <(dc --progress quiet run --no-deps --rm runner ruby bin/repos list)
  if [[ "$_USE_GATEWAY" == true ]]; then
    # proxy starts as claude's dependency; authgw is named explicitly so it only
    # runs in API-key mode (it requires the real key and would exit otherwise).
    dc up -d --wait --remove-orphans authgw claude
  else
    # OAuth: ensure the CLI is logged in (creds persist in .chomper/claude-auth).
    if ! dc run --rm claude claude auth status &>/dev/null; then
      echo "[ Claude auth required — follow the prompts below ]"
      dc run --rm --remove-orphans claude claude auth login
    fi
    dc up -d --wait --remove-orphans claude
  fi
  trap 'dc stop claude proxy authgw 2>/dev/null || true' EXIT INT TERM
fi
dc --progress quiet run --no-deps --rm --remove-orphans runner ruby "$SCRIPT_DIR/bin/chomper" "$@"
