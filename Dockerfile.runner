FROM ruby:4.0-slim

RUN apt-get update && apt-get install -y \
      build-essential \
      git \
    && rm -rf /var/lib/apt/lists/*

# --system (not --global): the runner runs as the host uid at runtime, not root,
# so the setting must live in system config rather than root's ~/.gitconfig.
RUN git config --system --add safe.directory '*'

WORKDIR /app
COPY Gemfile Gemfile.lock ./
RUN bundle install
