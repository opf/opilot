#!/usr/bin/env bash
# Git-level backstop: refuse any push to a deploy branch, no matter who or what
# initiates it from this checkout. Mirrors OPilot::Clients::GitHub.protected_branch?
# (lib/opilot/clients/github.rb) — keep the two in sync.
#
# OPilot points the worktree's core.hooksPath here (see ./opilot). git feeds
# pre-push one line per ref on stdin: "<local ref> <local sha> <remote ref> <remote sha>".
set -euo pipefail

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  branch="${remote_ref#refs/heads/}"
  # Base/deploy branches across every product repo opilot targets (dev for
  # openproject, main/master for the satellite repos) plus release*.
  if [[ "$branch" == "dev" || "$branch" == "main" || "$branch" == "master" || "$branch" == release* ]]; then
    echo "pre-push: refusing to push to protected branch '$branch'" >&2
    exit 1
  fi
done

exit 0
