FROM node:24-slim

# ripgrep backs pi's `grep` tool.
RUN apt-get update && apt-get install -y bash git ripgrep && rm -rf /var/lib/apt/lists/*

# Pinned with its whole dependency tree: pi stopped shipping npm-shrinkwrap.json
# in 1.0.1, so a plain `npm install -g` would resolve every transitive
# dependency afresh on each build. Bump in harness/pi (`npm install
# --package-lock-only`) after verifying the gateway path still works headless.
# server.js reads pi-ai's OpenRouter catalog from inside this install
# (OPENROUTER_CATALOG), so a bump must keep that path.
COPY harness/pi/package.json harness/pi/package-lock.json /opt/pi/
RUN cd /opt/pi && npm ci --ignore-scripts --omit=dev
ENV PATH=/opt/pi/node_modules/.bin:$PATH

RUN git config --system --add safe.directory '*' \
 && git config --system core.crossFS true

COPY --chown=node:node harness/server.js harness/pi-guards.ts harness/pi-mcp.ts harness/mcp-shape.js \
     harness/pi-settings.json harness/pi-models.json /app/harness/
# The MCP server registry server.js grants from, shared with mcp-gw and the runner.
COPY --chown=node:node gateways/mcp-ops.json /app/gateways/
# The role files: server.js checks each request's grant against its role. They
# sit at the same path relative to server.js as in the repo.
COPY --chown=node:node lib/opilot/prompts/*.yml /app/lib/opilot/prompts/

USER node

CMD ["node", "/app/harness/server.js"]
