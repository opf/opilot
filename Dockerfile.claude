FROM node:20-slim

RUN apt-get update && apt-get install -y bash git && rm -rf /var/lib/apt/lists/*

# Pinned: unpinned installs let each machine's image bake a different CLI
# version, and the bearer-token gateway auth (ANTHROPIC_BASE_URL +
# ANTHROPIC_AUTH_TOKEN, no API key in this container) regressed to "Not logged
# in" somewhere after 2.1.170. Bump deliberately after verifying the gateway
# path still works headless.
RUN npm install -g @anthropic-ai/claude-code@2.1.210

RUN git config --system --add safe.directory '*' \
 && git config --system core.crossFS true

COPY --chown=node:node server.js claude-settings.json guard-writes.js guard-bash.js /app/

USER node

CMD ["node", "/app/server.js"]
