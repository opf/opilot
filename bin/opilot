#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "rainbow"
require "git"

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "opilot/context"
require "opilot/clients"
require "opilot/helpers"
require "opilot/prompts"
require "opilot/harness"
require "opilot/ui"
require "opilot/pull"
require "opilot/publish"
require "opilot/agent"
require "opilot/gh_pull"
require "opilot/gh_agent"
require "opilot/combined_agent"
require "opilot/fix_runner"
require "opilot/pr_runner"
require "opilot/pull_runner"
require "opilot/chat_runner"
require "opilot/usage_runner"
# opilot/pd is NOT required here: only `pd` uses the pipeline, so CLI#pd requires
# it on demand (and opilot/pd/intake later still — it pulls in roo, nokogiri and
# rubyzip, which only the stages that read a document ever need). The one part
# that does load eagerly is PD::ChangeStore, via gh_pull above.
require "opilot/cli"

Rainbow.enabled = $stdout.tty?

ctx = OPilot::Context.build

def reset_terminal
  $stdout.print(Rainbow("").reset)
  $stdout.flush
end

# Ctrl-C ends everything immediately. `exit` raises SystemExit at whatever
# point the main thread is blocked, and SystemExit is not a StandardError, so
# it passes every `rescue => e` on the way out — the in-flight item is neither
# acked nor error-reported, and the next run retries it.
Signal.trap("INT") do
  reset_terminal
  puts "\nCtrl-C received, aborting..."
  exit 130
end

Signal.trap("TERM") do
  reset_terminal
  exit 143
end

begin
  OPilot::CLI.new(ctx).run(ARGV)
rescue OPilot::FatalError => e
  $stderr.puts "Error: #{e.message}" unless e.message.nil? || e.message == e.class.name
  exit 1
end
