#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "rainbow"
require "git"

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "chomper/context"
require "chomper/clients"
require "chomper/helpers"
require "chomper/prompts"
require "chomper/claude"
require "chomper/ui"
require "chomper/pull"
require "chomper/publish"
require "chomper/agent"
require "chomper/gh_pull"
require "chomper/gh_agent"
require "chomper/combined_agent"
require "chomper/fix_runner"
require "chomper/pr_runner"
require "chomper/pull_runner"
require "chomper/chat_runner"
require "chomper/cli"

Rainbow.enabled = $stdout.tty?

ctx = Chomper::Context.build

def reset_terminal
  $stdout.print(Rainbow("").reset)
  $stdout.flush
end

# First Ctrl-C asks the agent loop to stop after the current intent; a second
# one forces an immediate exit (the agent sets stopping? after the first).
Signal.trap("INT") do
  if Chomper.stopping?
    reset_terminal
    puts ""
    puts "Forced stop."
    exit 130
  else
    Chomper.request_stop
    $stderr.puts "\nStopping after the current item… (Ctrl-C again to force)"
  end
end

Signal.trap("TERM") do
  reset_terminal
  exit 143
end

begin
  Chomper::CLI.new(ctx).run(ARGV)
rescue Chomper::FatalError => e
  $stderr.puts "Error: #{e.message}" unless e.message.nil? || e.message == e.class.name
  exit 1
end
