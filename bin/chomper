#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "rainbow"
require "git"

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "chomper/context"
require "chomper/clients"
require "chomper/helpers"
require "chomper/prompts"
require "chomper/claude"
require "chomper/ui"
require "chomper/pull"
require "chomper/publish"
require "chomper/agent"
require "chomper/gh_pull"
require "chomper/gh_agent"
require "chomper/combined_agent"
require "chomper/fix_runner"
require "chomper/pr_runner"
require "chomper/pull_runner"
require "chomper/chat_runner"
# chomper/pd is NOT required here: only `pd` uses the pipeline, so CLI#pd requires
# it on demand (and chomper/pd/intake later still — it pulls in roo, nokogiri and
# rubyzip, which only the stages that read a document ever need). The one part
# that does load eagerly is PD::ChangeStore, via gh_pull above.
require "chomper/cli"

Rainbow.enabled = $stdout.tty?

ctx = Chomper::Context.build

def reset_terminal
  $stdout.print(Rainbow("").reset)
  $stdout.flush
end

# Ctrl-C ends everything immediately. `exit` raises SystemExit at whatever
# point the main thread is blocked, and SystemExit is not a StandardError, so
# it passes every `rescue => e` on the way out — the in-flight item is neither
# acked nor error-reported, and the next run retries it.
Signal.trap("INT") do
  reset_terminal
  puts "\nCtrl-C received, aborting..."
  exit 130
end

Signal.trap("TERM") do
  reset_terminal
  exit 143
end

begin
  Chomper::CLI.new(ctx).run(ARGV)
rescue Chomper::FatalError => e
  $stderr.puts "Error: #{e.message}" unless e.message.nil? || e.message == e.class.name
  exit 1
end
