#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "rainbow"
require "git"

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "chomper/context"
require "chomper/backlog"
require "chomper/http"
require "chomper/helpers"
require "chomper/prompts"
require "chomper/claude"
require "chomper/ui"
require "chomper/pull"
require "chomper/triage"
require "chomper/fix"
require "chomper/publish"
require "chomper/cli"

Rainbow.enabled = $stdout.tty?

ctx = Chomper::Context.build

def reset_terminal
  $stdout.print(Rainbow("").reset)
  $stdout.flush
end

Signal.trap("INT") do
  reset_terminal
  puts ""
  puts "Interrupted — run ./chomper to resume."
  exit 130
end

Signal.trap("TERM") do
  reset_terminal
  exit 143
end

begin
  Chomper::CLI.new(ctx).run(ARGV)
rescue Chomper::FatalError => e
  $stderr.puts "Error: #{e.message}" unless e.message.nil? || e.message == e.class.name
  exit 1
end
