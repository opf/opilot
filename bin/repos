#!/usr/bin/env ruby
# frozen_string_literal: true
#
# Registry helper, run inside the runner container (it has Ruby + repos.json via
# the SCRIPT_DIR mount, which the host shell lacks). Two subcommands:
#
#   list      print one `name|upstream|base|shared_repo_path` line per repo, for
#             ./chomper to provision each worktree on the host.
#   override  (re)generate compose.override.yml — the per-repo source-checkout
#             mounts that make linked worktrees' git resolve in the containers.
#
# Paths are emitted as real host paths: SCRIPT_DIR is mounted at its real path,
# so a relative shared_repo_path resolves to the same absolute path the host
# sees, and the mounts in the override line up on both sides.

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "chomper/repo"

script_dir = ENV.fetch("SCRIPT_DIR", Dir.pwd)
state_dir  = File.join(script_dir, ".chomper")
registry   = Chomper::Registry.build(script_dir: script_dir, state_dir: state_dir,
                                     op_repo_path: ENV["OP_REPO_PATH"])

case ARGV[0]
when "list"
  registry.all.each do |r|
    puts [r.name, r.upstream, r.base, r.shared_repo_path].join("|")
  end
when "override"
  linked = registry.all.select(&:linked?)
  runner_mounts = linked.map { |r| "      - #{r.shared_repo_path}:#{r.shared_repo_path}" }
  # Read-only in claude: it only browses git history there, never writes.
  claude_mounts = linked.map { |r| "      - #{r.shared_repo_path}:#{r.shared_repo_path}:ro" }

  out = +"# Generated by ./chomper from repos.json — do not edit by hand.\n"
  out << "# Mounts each linked-worktree repo's shared checkout at its real host path so\n"
  out << "# the runner's git (and Claude's read-only git history) resolve the gitdir link.\n"
  out << "services:\n"
  if runner_mounts.any?
    out << "  runner:\n    volumes:\n#{runner_mounts.join("\n")}\n"
    out << "  claude:\n    volumes:\n#{claude_mounts.join("\n")}\n"
  else
    # No linked worktrees (all standalone clones) — nothing extra to mount, but
    # emit a valid no-op so `docker compose` always finds the file.
    out << "  runner: {}\n"
  end
  File.write(File.join(script_dir, "compose.override.yml"), out)
else
  warn "usage: bin/repos {list|override}"
  exit 1
end
