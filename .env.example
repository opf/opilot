# Copy to .env and fill in your values.
# .env is gitignored; this file is not.

# ── OpenProject ───────────────────────────────────────────
# URL of your OpenProject instance
OPENPROJECT_URL=https://community.openproject.org

# Read-only API token (My Account → Access Tokens → View work packages)
OPENPROJECT_TOKEN=your_api_token_here

# ── Repos ─────────────────────────────────────────────────
# The set of product repos chomper fixes is defined in repos.json (name, upstream
# owner/repo, base branch, and a description). Claude picks which repo(s) a fix
# lands in, per work package. Edit repos.json to add or change repos.
#
# Optional: point the openproject clone at a local checkout to seed a faster
# clone (git clone --reference-if-able … --dissociate). Absent → clones fresh.
# OP_REPO_PATH=../openproject

# ── Behaviour ─────────────────────────────────────────────
# Comma-separated list of OpenProject user ids allowed to trigger the agent via
# @chomper comments (the number in a profile URL, /users/<id> — not emails, since a
# non-admin API token can't read other users' emails).
# If unset or empty, every OpenProject user may trigger the agent.
# CHOMPER_ALLOWED_OP_USER_IDS=534,557

# ── Models (all optional) ─────────────────────────────────
# Work model for all planning and implementation.
# CHOMPER_MODEL=claude-opus-4-8
# Fast model for stateless one-shot passes (e.g. the gh-agent commit subject).
# CHOMPER_TRIAGE_MODEL=claude-haiku-4-5
# Set to 1/true to re-enable the agent-mode self-review pass (off by default —
# a human approves every plan via @chomper approve).
# CHOMPER_PLAN_REVIEW=1
# Set to 1/true to auto-approve every plan instead of waiting for a human:
# fix/plan skip the terminal approval prompt, and agent mode implements a
# planned WP immediately rather than waiting for @chomper approve. Unattended —
# use with care.
# AUTO_PLAN_APPROVAL=1
# Set to 0/false to disable terminal Markdown rendering of Claude's output.
# CHOMPER_MARKDOWN=0

# ── Claude / Docker ───────────────────────────────────────
# Anthropic API key — recommended. When set, it is held only by the authgw
# gateway container and never passed to the claude container (which runs
# untrusted work-package content). Leave unset/blank to fall back to interactive
# `claude auth login` — the OAuth creds then live in the claude container, which
# is less isolated.
# ANTHROPIC_API_KEY=sk-ant-...
