# Copy to .env and fill in your values.
# .env is gitignored; this file is not.

# ── OpenProject ───────────────────────────────────────────
# URL of your OpenProject instance
OPENPROJECT_URL=https://community.openproject.org

# Read-only API token (My Account → Access Tokens → View work packages)
OPENPROJECT_TOKEN=your_api_token_here

# ── Local paths ───────────────────────────────────────────
# Absolute or relative path to your openproject checkout.
# Set to false to have chomper clone a fresh copy into .chomper/openproject automatically.
OP_REPO_PATH=../openproject

# ── Behaviour ─────────────────────────────────────────────
# Set to false to skip the interactive plan approval prompt and implement automatically.
# REQUIRE_PLAN_APPROVAL=false

# Comma-separated list of emails allowed to trigger the agent via @chomper comments.
# If unset or empty, every OpenProject user may trigger the agent.
# CHOMPER_ALLOWED_EMAILS=alice@example.com,bob@example.com

# ── Claude / Docker ───────────────────────────────────────
# Anthropic API key — optional if you authenticate interactively via `claude auth login`
# ANTHROPIC_API_KEY=sk-ant-...
