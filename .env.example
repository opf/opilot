# Copy to .env and fill in your values.
# .env is gitignored; this file is not.

# ── OpenProject ───────────────────────────────────────────
# URL of your OpenProject instance
OP_URL=https://community.openproject.org

# Read-only API token (My Account → Access Tokens → View work packages)
TOKEN=your_api_token_here

# Project identifier as it appears in the URL (e.g. /projects/my-project)
PROJECT_ID=my-project

# ── Local paths ───────────────────────────────────────────
# Absolute or relative path to your openproject checkout.
# Set to false to have chomper clone a fresh copy into .chomper/openproject automatically.
OP_REPO_PATH=../openproject

# ── Claude / Docker ───────────────────────────────────────
# Docker image name for the Claude Code container (built automatically if missing)
CLAUDE_IMAGE=chomper-claude

# Anthropic API key — optional if you authenticate interactively via `claude auth login`
# ANTHROPIC_API_KEY=sk-ant-...
