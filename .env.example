# Copy to .env and fill in your values.
# .env is gitignored; this file is not.

# ── OpenProject ───────────────────────────────────────────
# URL of your OpenProject instance
OPENPROJECT_URL=https://community.openproject.org

# API token (My Account → Access Tokens). Read access to work packages is enough
# for `wp` and `chat`; agent mode also needs permission to comment, and the `pd`
# pipeline additionally needs add-work-packages (it creates the FEATURE tree).
OPENPROJECT_TOKEN=your_api_token_here

# ── Repos ─────────────────────────────────────────────────
# The set of product repos opilot fixes is defined in repos.json (name, upstream
# owner/repo, base branch, and a description). The LLM picks which repo(s) a fix
# lands in, per work package. Edit repos.json to add or change repos.
#
# Optional: point the openproject clone at a local checkout to seed a faster
# clone (git clone --reference-if-able … --dissociate). Absent → clones fresh.
# OP_REPO_PATH=../openproject

# ── GitHub ────────────────────────────────────────────────
# The BOT account opilot publishes as — not you. It forks each product repo,
# pushes fix branches to its fork, and opens cross-repo draft PRs; it must NOT be
# a collaborator on the canonical repos (that lack of access is the isolation).
# Classic token, scopes: public_repo, workflow, gist. Fine-grained tokens cannot
# open fork→upstream PRs. Without it nothing can be published.
GITHUB_CONTRIBUTOR_TOKEN=ghp_your_bot_token_here

# ── Behaviour ─────────────────────────────────────────────
# Comma-separated list of OpenProject user ids allowed to trigger the agent via
# @opilot comments (the number in a profile URL, /users/<id> — not emails, since a
# non-admin API token can't read other users' emails).
# If unset or empty, every OpenProject user may trigger the agent.
# OPILOT_ALLOWED_OP_USER_IDS=534,557

# Comma-separated GitHub logins allowed to trigger @opilot on a PR (gh-agent).
# If unset or empty, any GitHub user can trigger on opilot's own PRs.
# OPILOT_ALLOWED_GH_USERS=thykel

# Also track the product repos' UPSTREAM PRs, so an @opilot mention on someone
# else's PR gets answered (read-only: opilot replies and can offer GitHub
# suggestions, but has no push access there). Off unless set — this is the only
# thing that makes opilot search outside its own PRs, so enabling it is a
# deliberate spend decision. Requires OPILOT_ALLOWED_GH_USERS as well.
# OPILOT_TRACK_UPSTREAM_PRS=1

# Set to 0/false to stop treating "opilot is one of the Developers" as @opilot
# ship (on by default; setting the field needs OpenProject edit rights, and is
# not gated by OPILOT_ALLOWED_OP_USER_IDS — turn it off where WP edit rights
# are broad). OPILOT_ASSIGN_TRIGGER is still honoured as the older name.
# OPILOT_DEVELOPER_TRIGGER=0

# Which field fires that trigger, matched against the work-package schema's
# field names (case-insensitive). "Developers" is a user custom field, so its id
# differs per instance and is resolved by name. Naming a stock field works too:
# OPILOT_DEVELOPER_FIELD=Assignee triggers on the assignee instead.
# OPILOT_DEVELOPER_FIELD=Developers

# gh-agent's CI chasing: how many times it will fix one PR's CI before asking for
# a human, and the check names it should not try to fix (comma-separated,
# case-insensitive; "SaaS tests" needs secrets a fork PR cannot have).
# OPILOT_CI_MAX_ATTEMPTS=5
# OPILOT_CI_IGNORE_CHECKS=SaaS tests

# ── Product development (`pd`, all optional) ──────────────
# Work-package types the pipeline maps onto: a change becomes one parent, each
# tasks.md section a child. Neither is a stock OpenProject type, and ids differ
# per instance, so both are resolved BY NAME at `pd init`.
# OPILOT_PD_PARENT_TYPE=FEATURE
# OPILOT_PD_CHILD_TYPE=IMPLEMENTATION
# Statuses `pd implement` sets when it starts, and once the draft PR is open.
# Resolved by name (case-insensitively); set empty to skip that transition.
# OPILOT_PD_IMPLEMENTING_STATUS=In progress
# OPILOT_PD_IMPLEMENTED_STATUS=Developed

# ── Models (all optional) ─────────────────────────────────
# Work model for all planning and implementation. Values are OpenRouter slugs
# behind pi's provider prefix (openrouter/<vendor>/<model>), not Anthropic API
# ids. Run `pi --list-models anthropic` in the harness container for the full
# catalog.
# OPILOT_MODEL=openrouter/anthropic/claude-opus-4.8
# Fast model for stateless one-shot passes (e.g. the gh-agent commit subject).
# OPILOT_TRIAGE_MODEL=openrouter/anthropic/claude-haiku-4.5

# ── Harness / Docker ──────────────────────────────────────
# OpenRouter API key — required. Held only by the authgw gateway container and
# never passed to the harness container (which runs untrusted work-package
# content). Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
